
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RandomVideoDistributor.Views.CloseConfirmationWindow"
        Title="تأكيد الإغلاق"
        Width="380"
        Height="180"
        MinWidth="380"
        MinHeight="180"
        MaxWidth="380"
        MaxHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Grid RowDefinitions="*,Auto"
          Margin="24"
          RowSpacing="20">

        <TextBlock Grid.Row="0"
                   Text="هل تريد بالتأكيد إغلاق البرنامج؟"
                   FontSize="16"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

            <Button Content="إلغاء"
                    MinWidth="85"
                    Click="Cancel_Click" />

            <Button Content="إغلاق"
                    MinWidth="85"
                    IsDefault="True"
                    Click="Confirm_Click" />

        </StackPanel>
    </Grid>
</Window>
